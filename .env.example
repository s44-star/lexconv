# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Required: Resend API key (resend.com → API Keys). Needs "Sending access" for lexconv.com.
RESEND_API_KEY=

# Optional: where contact-form messages go (default: ceo@lexconv.com)
CONTACT_TO_EMAIL=ceo@lexconv.com

# Optional: the sender shown on the e-mail. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=LexConv website <website@lexconv.com>

# Optional but recommended: Upstash Redis (free tier) for rate limiting that is shared
# across all servers. Without these, the form still rate-limits, but per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
